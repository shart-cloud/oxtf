(body
  (attr a (- (+ 1 (* 2 3)) (% (/ 4 5) 6)))
  (attr b (|| (&& (! (trav var .x)) (trav var .y)) (&& (== (trav var .z) 1) (!= (trav var .w) 2))))
  (attr c (|| (|| (< (trav var .a) 1) (&& (>= (trav var .b) 2) (<= (trav var .c) 3))) (> (trav var .d) 4)))
  (attr d (? (trav var .x) (? (trav var .y) 1 2) (? (trav var .z) 3 4)))
  (attr e (+ (neg (trav var .n)) (neg 1)))
  (attr f (! (! true)))
  (attr g (* (paren (+ 1 2)) 3))
  (attr h (? (== (trav var .a) null) "default" (trav var .a))))
